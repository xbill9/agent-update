#!/usr/bin/env bash
# claude-update — install or update Claude Code (native build) to the latest release.
#
#   claude   CLI   ~/.local/bin/claude   official install.sh from claude.ai
#
# The installer is idempotent: it installs when claude is missing and updates
# it otherwise. A running claude session keeps the old binary until restarted.
#
# Usage: claude-update [--check]
#   --check   print the installed version and exit without changing anything
#
# Needs curl. Exit status: 0 on success, non-zero if the download or the
# installer failed, 2 on a bad argument.
set -euo pipefail

CHECK=0
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "unknown argument: $a" >&2; exit 2 ;;
  esac
done

log() { printf '\033[1m[%s]\033[0m %s\n' claude "$1"; }
# Installed version, or "none" when claude is not on PATH.
ver() { { command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | head -1; } || echo none; }

before="$(ver)"
if [ $CHECK = 1 ]; then log "installed: $before"; exit 0; fi

# pipefail makes a failed download fail the pipeline, not just a failed install.
curl -fsSL https://claude.ai/install.sh | bash
hash -r   # forget a cached path, in case the install moved the binary
log "$before -> $(ver)"
