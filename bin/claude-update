#!/usr/bin/env bash
# claude-update — install or update Claude Code (native build) to the latest release.
#
#   claude   CLI   ~/.local/bin/claude   official install.sh from claude.ai
#
# Usage: claude-update [--check]
#   --check   print the installed version and exit without changing anything
set -euo pipefail

CHECK=0
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) echo "unknown argument: $a" >&2; exit 2 ;;
  esac
done

log() { printf '\033[1m[%s]\033[0m %s\n' claude "$1"; }
ver() { claude --version 2>/dev/null | head -1 || true; }

before="$(command -v claude >/dev/null 2>&1 && ver || echo none)"
if [ $CHECK = 1 ]; then log "installed: $before"; exit 0; fi

curl -fsSL https://claude.ai/install.sh | bash
hash -r
log "$before -> $(ver)"
