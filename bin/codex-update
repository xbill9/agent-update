#!/usr/bin/env bash
# codex-update — install or update the OpenAI Codex CLI to the latest release.
#
#   codex    CLI   ~/.local/bin/codex    official install.sh from chatgpt.com, non-interactive
#
# Usage: codex-update [--check]
#   --check   print the installed version and exit without changing anything
set -euo pipefail

CHECK=0
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) echo "unknown argument: $a" >&2; exit 2 ;;
  esac
done

log() { printf '\033[1m[%s]\033[0m %s\n' codex "$1"; }
ver() { codex --version 2>/dev/null | head -1 || true; }

before="$(command -v codex >/dev/null 2>&1 && ver || echo none)"
if [ $CHECK = 1 ]; then log "installed: $before"; exit 0; fi

curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
hash -r
log "$before -> $(ver)"
