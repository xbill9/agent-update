#!/usr/bin/env bash
# deploy — publish bin/* to the stage bucket and copy it into ~/bin.
#
# The bucket is the source of truth for ~/bin: update-all runs update-update,
# which deletes every *-update in ~/bin and copies them back from the bucket.
# A script that is only in ~/bin is lost on the next update-all, so deploy
# writes the bucket first.
#
# Usage: ./deploy [--local] [--dry-run]
#   --local     copy into ~/bin only, leave the bucket alone
#   --dry-run   show what would be copied
set -euo pipefail

BUCKET="${BUCKET:-gs://stage.ticket.w5.glitnirticketing.com}"
DEST="${DEST:-$HOME/bin}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

LOCAL=0 DRY=0
for a in "$@"; do
  case "$a" in
    --local) LOCAL=1 ;;
    --dry-run) DRY=1 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) echo "unknown argument: $a" >&2; exit 2 ;;
  esac
done

run() { if [ $DRY = 1 ]; then echo "+ $*"; else "$@"; fi; }

"$root/test"

for f in "$root"/bin/*; do
  name="${f##*/}"
  [ $LOCAL = 1 ] || run gcloud storage cp --quiet "$f" "$BUCKET/$name"
  run install -m 755 "$f" "$DEST/$name"
done
